        <mxCell id="9TpmL8N8DztCTWZ4Ac1d-3" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;Cadastro manual de todos os segredos no GitHub uma única vez&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="150" y="170" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="9TpmL8N8DztCTWZ4Ac1d-8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="9TpmL8N8DztCTWZ4Ac1d-4" target="9TpmL8N8DztCTWZ4Ac1d-7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="9TpmL8N8DztCTWZ4Ac1d-4" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;PIPELINE a cada push na main:&lt;/font&gt;&lt;div&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;div&gt;&lt;font style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;1. Terraform lê os secrets do GitHub&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 18px;&quot;&gt;e os escreve no SSM da AWS (criptografados);&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;2. Builda a imagem Docker e sobe no ECR&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 18px;&quot;&gt;(imagem não contém nenhum segredo);&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;3. ECS puxa a nova imagem e sobe o container.&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="170" width="530" height="210" as="geometry" />
        </mxCell>
        <mxCell id="9TpmL8N8DztCTWZ4Ac1d-7" value="&lt;div&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;CONTAINER (a cada inicialização):&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;1. entrypoint.sh executa;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 18px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;2. Busca os parâmetros no SSM da AWS;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 18px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;3. Escreve os .pem em disco;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 18px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;4. Exporta as demais credenciais como env vars;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 18px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;5. Sobe a aplicação Java.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="540" width="530" height="210" as="geometry" />
        </mxCell>
